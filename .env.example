# PostgreSQL(コンテナ起動時の認証情報)
# 本番では必ず十分な長さのランダム値に差し替えること(ダミー固定値の使用は禁止)。
POSTGRES_USER="mochikata"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_RANDOM"
POSTGRES_DB="mochikata"

# ホスト側に 5432 を晒す必要がある場合のみ設定(例: 127.0.0.1:5432)。
# 本番やリモート運用では未設定のまま(= 非公開)にする。
# POSTGRES_HOST_BIND="127.0.0.1:5432"

# アプリ側は上と同じ資格情報でコンテナ間接続する(ホスト公開とは独立)。
DATABASE_URL="postgresql://mochikata:REPLACE_WITH_STRONG_RANDOM@localhost:5432/mochikata?schema=public"

# iron-session (任意の32文字以上のランダム文字列)
SESSION_SECRET="change-me-to-32-chars-or-more-random-string"

# 外部サービス認証情報(manaba パスワード / CITポータル TOTPシークレット 等)の
# 暗号化鍵。32文字以上のランダム値を SESSION_SECRET とは別に生成して入れる。
# 未設定なら SESSION_SECRET にフォールバック(後方互換)。
# 別鍵にしておくと Cookie 鍵 (SESSION_SECRET) 漏えい時にも認証情報暗号化までは漏れない。
# この値を変更すると保存済み認証情報は復号不能になり再入力が必要。
CREDENTIAL_ENCRYPTION_KEY=""

# 初回起動時のPIN(初回ログイン後にアプリ内で変更すること。0000 等の弱い値を残さない)
INITIAL_PIN="REPLACE_ON_FIRST_RUN"

# セッション Cookie の Secure フラグ。HTTP のローカル docker(本番ビルド)で
# ブラウザに Cookie を保存させるため "false" を指定。HTTPS で公開する場合は
# "true" にすること。未指定なら NODE_ENV=production で true。
SESSION_COOKIE_SECURE=""

# Google カレンダー連携 (Phase 1)。
# 取得手順: docs/google-calendar.md の "Google Cloud Console 設定手順" を参照。
# 1. Google Cloud Console でプロジェクト作成 → Calendar API 有効化
# 2. OAuth 同意画面を構成 (スコープに auth/calendar を追加)
# 3. OAuth クライアント ID 作成 (ウェブアプリケーション)、redirect URI に
#    {GOOGLE_OAUTH_REDIRECT_BASE}/api/oauth/google/callback を登録
# 未連携で動かす場合は 3 つ全部空のままで OK (UI から「連携」ボタンを
# 押した時にエラーになるだけ)。
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_BASE="http://localhost:3000"

# 内部cron(worker)から /api/jobs/* を叩くためのトークン
# 32文字以上のランダム文字列。漏えい時はローテートする
JOBS_TOKEN="change-me-32chars-random-token-please"

# Push通知のロック画面プレビュー: 内容を出さない場合 true
PUSH_HIDE_PAYLOAD="true"

# 信頼プロキシ経由(Tailscale等)で X-Forwarded-For を採用するか
# 直接外部公開している/プロキシなしなら false にする(IP偽装によるレート制限回避を防ぐ)
TRUST_PROXY="false"

# CSRF(Origin/Refererチェック)で受け入れる自サイト Origin(スキーム+ホスト+ポート)。
# 例: http://localhost:3000 / https://mochikata.example.com
# 複数許可するときはカンマ区切り
APP_ORIGIN="http://localhost:3000"

# Slack通知
SLACK_WEBHOOK_URL=""

# Web Push (VAPID) — `npx web-push generate-vapid-keys` で生成
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:yoppy03.work@gmail.com"

# アプリ全体のタイムゾーン
TZ="Asia/Tokyo"

# manaba 連携(認証付きスクレイピング)。
# CIT 以外の大学を使う場合のみ書き換え。
MANABA_BASE_URL="https://cit.manaba.jp"
