generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id        Int      @id @default(autoincrement())
  pinHash   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  color     String?
  templates TemplateTag[]
  classes   ClassTag[]
  instances TaskInstanceTag[]
  createdAt DateTime         @default(now())
}

enum TemplateKind {
  MANUAL
  RECURRING
  CLASS
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum TaskPriority {
  LOW
  MID
  HIGH
}

enum TaskSource {
  MANUAL
  RECURRING
  CLASS
  ACADEMIC
  GOOGLE
}

enum ReminderChannel {
  SLACK
  PUSH
}

enum ReminderStatus {
  PENDING
  SENT
  SKIPPED
  ACKED
  FAILED
}

enum AcademicKind {
  EXAM
  HOLIDAY
  EVENT
}

enum ChecklistOwnerType {
  TEMPLATE
  CLASS
}

enum NoteKind {
  INBOX  // あとでタスクに昇格できる思いつき置き場
  DIARY  // 日付に紐付いた日次メモ
}

enum ItemType {
  TASK   // やること(チェックして消す)
  EVENT  // 予定(時間拘束・事実。授業等)
}

model TaskTemplate {
  id                  Int            @id @default(autoincrement())
  kind                TemplateKind
  itemType            ItemType       @default(TASK)
  required            Boolean        @default(true)
  title               String
  notes               String?
  priority            TaskPriority   @default(MID)
  defaultDueOffsetMin Int            @default(0)
  rrule               String?
  classScheduleId     Int?
  classSchedule       ClassSchedule? @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)
  tags                TemplateTag[]
  instances           TaskInstance[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model TemplateTag {
  templateId Int
  tagId      Int
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag        Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
}

model ClassSchedule {
  id            Int            @id @default(autoincrement())
  dayOfWeek     Int
  // CIT は 9:00 から 1 時間刻みの 10 限制。複数限連続(2-4限)が基本のため
  // 開始限 (period) と 終了限 (endPeriod) のレンジで表現する。
  period        Int
  endPeriod     Int            @default(1)
  startTime     String
  endTime       String
  courseName    String
  classroom     String?
  teacher       String?
  // ユーザが指定したカード色 (例 "#0ea5e9")。null の場合は科目名ハッシュで自動配色。
  color         String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  // この行がどこから入ってきたか。
  //   null         : 手動追加 (UI / API 直叩き)
  //   "cit-portal" : CITポータル同期で自動取り込み
  // CIT同期の全置換ロジックは "cit-portal" 由来行だけを削除対象にし、
  // 手動授業を守るために必須。
  importedFrom  String?
  tags          ClassTag[]
  templates     TaskTemplate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([dayOfWeek, period])
  @@index([importedFrom])
}

model ClassTag {
  classId Int
  tagId   Int
  class   ClassSchedule @relation(fields: [classId], references: [id], onDelete: Cascade)
  tag     Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([classId, tagId])
}

model ChecklistTemplate {
  id        Int                @id @default(autoincrement())
  ownerType ChecklistOwnerType
  ownerId   Int
  label     String
  orderIdx  Int                @default(0)
  createdAt DateTime           @default(now())

  @@index([ownerType, ownerId])
}

model TaskInstance {
  id               Int                 @id @default(autoincrement())
  templateId       Int?
  template         TaskTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title            String
  notes            String?
  dueAt            DateTime
  itemType         ItemType            @default(TASK)
  required         Boolean             @default(true)
  priority         TaskPriority        @default(MID)
  status           TaskStatus          @default(OPEN)
  completedAt      DateTime?
  source           TaskSource
  sourceExternalId String?
  tags             TaskInstanceTag[]
  checklist        TaskInstanceCheck[]
  reminders        Reminder[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([templateId, dueAt], name: "unique_template_due")
  // 外部ソース(manaba/CIT等)からの取込で重複行を作らないための一意制約。
  // (source, sourceExternalId) ペアでユニーク。MANUAL タスクは
  // sourceExternalId が NULL なので Postgres の NULL=distinct 規約で複数OK。
  @@unique([source, sourceExternalId], name: "unique_source_external")
  @@index([status, dueAt])
}

model TaskInstanceTag {
  instanceId Int
  tagId      Int
  instance   TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tag        Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([instanceId, tagId])
}

model TaskInstanceCheck {
  id             Int          @id @default(autoincrement())
  instanceId     Int
  instance       TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  label          String
  orderIdx       Int          @default(0)
  checkedAt      DateTime?
  fromTemplateId Int?
  createdAt      DateTime     @default(now())

  @@index([instanceId, orderIdx])
}

model Reminder {
  id              Int             @id @default(autoincrement())
  instanceId      Int
  instance        TaskInstance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  remindAt        DateTime
  channel         ReminderChannel
  escalationLevel Int             @default(0)
  status          ReminderStatus  @default(PENDING)
  sentAt          DateTime?
  ackedAt         DateTime?
  dedupeKey       String          @unique
  attempts        Int             @default(0)
  // dispatcher 排他用の claim タイムスタンプ。NULL = 誰も保持していない。
  // 配信処理の途中でクラッシュした場合は古い claimedAt がそのまま残るが、
  // pickup クエリで stale (= 5分以上前) を許容するので自動回復する。
  // attempts とは分離: claim だけでは attempts を増やさず、実際の送信
  // 試行(成功/失敗)時にのみ加算するため、再起動でリトライ枠を消費しない。
  claimedAt       DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())

  @@unique([instanceId, remindAt, channel, escalationLevel], name: "unique_reminder")
  @@index([status, remindAt])
}

model AcademicEvent {
  id           Int          @id @default(autoincrement())
  title        String
  date         DateTime
  kind         AcademicKind
  importedFrom String?
  createdAt    DateTime     @default(now())

  @@index([date])
}

// 「この日は授業がある」を年単位で永続化するテーブル。
// 千葉工大の学年歴 PDF 取り込み時に、学期境界 + 休講 + 祝日授業日 から
// 計算してまとめて bulk insert する。
// date は JST 0:00 を表す UTC instant(他テーブルの慣習に合わせる)。
model ClassDay {
  date      DateTime @id
  createdAt DateTime @default(now())
}

// manaba 連携用の暗号化保存資格情報(単一ユーザー前提なので 1 行のみ)。
// passwordEnc は AES-256-GCM。鍵は SESSION_SECRET 派生で暗号化(crypto.ts)。
// lastError には直近の同期時のエラー(あれば)、lastSyncedAt は最終成功時刻。
// singletonKey は固定値 "default" を入れて DB レベルで 1 行制約を効かせる
// (並行書き込みでの重複行を防ぐ; upsert で使う)。
model ManabaCredential {
  id            Int       @id @default(autoincrement())
  singletonKey  String    @unique @default("default")
  username      String
  passwordEnc   String
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// CITポータル(Universal Passport RX)連携用の暗号化保存資格情報。
// SSO + MFA(TOTP)経由でログインするため、TOTPシークレットも保存する。
// 注意: passwordEnc と totpSecretEnc が同一鍵(SESSION_SECRET派生)で
// 暗号化されているため、DB+鍵が同時に漏洩した場合 MFA 保護は実質失われる。
// 単一ユーザー前提のため 1 行のみ。singletonKey で DB 一意性も保証する
// (並行 save での重複挿入を防ぐ)。
model CitPortalCredential {
  id             Int       @id @default(autoincrement())
  singletonKey   String    @unique @default("default")
  username       String
  passwordEnc    String
  totpSecretEnc  String
  // Keycloakのクレデンシャル選択画面で選ぶデバイス名(部分一致でマッチ)。
  // 例: "PC(motica)" などポータルでTOTP登録時に付けた名前。
  // 未設定だと最初のクレデンシャルが選ばれる。
  totpDeviceName String?
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Google カレンダー連携用の OAuth 2.0 認証情報(単一ユーザー前提なので 1 行のみ)。
// refreshTokenEnc は AES-256-GCM。鍵は CREDENTIAL_ENCRYPTION_KEY 派生 (DOMAIN="google-calendar")。
// accessToken は短寿命 (~1h) なので生で持つが、worker/web 間で共有するため DB に置く。
// accessTokenExpiresAt が過去になったら refresh する。
// scope は認可されたスコープ文字列 (検証用; ユーザーが Google 側で剥がしたら検知できる)。
// email は表示用 + どの Google アカウントで連携したかの記録。
// lastSyncAt / lastError は他 credential と同じ運用ログ。
// singletonKey は固定値 "default" を入れて DB レベルで 1 行制約を効かせる。
model GoogleCredential {
  id                    Int       @id @default(autoincrement())
  singletonKey          String    @unique @default("default")
  email                 String
  refreshTokenEnc       String
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  scope                 String
  // 次回 incremental sync 用 token。null なら次回 full sync (timeMin=now-30d)。
  // events.list の応答に含まれる nextSyncToken を保存し、次回そのまま使う。
  // 410 Gone (= token 失効) を受けたら null に戻して full sync に降格。
  syncToken             String?
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

// ログイン総当たり対策。プロセス内メモリではなく Postgres に永続化して
// 再起動や複数プロセスでカウントが消えないようにする。
model LoginAttempt {
  key           String   @id
  failures      Int      @default(0)
  windowStart   DateTime @default(now())
  lockoutUntil  DateTime?
  updatedAt     DateTime @updatedAt
}

// ────────────────────────────────────────────────
// メモ(ワーキングメモリ置き場)
// INBOX: 未消化の思いつき。タスクに昇格できる
// DIARY: 日付に紐付いた日記的メモ
// 時系列ストリームは kind 横断で createdAt 逆順に表示
// ────────────────────────────────────────────────
model Note {
  id             Int       @id @default(autoincrement())
  body           String
  kind           NoteKind  @default(INBOX)
  diaryDate      DateTime? // DIARYのみ使用(日付のみ、時刻は00:00 JST)
  archivedAt     DateTime? // 消化済み(INBOXのみ)
  promotedTaskId Int?      // タスクに昇格した場合の参照
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([kind, archivedAt, createdAt])
  @@index([diaryDate])
}
